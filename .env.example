# ============================================================
# Sistem Pameran — contoh konfigurasi environment
# Salin file ini menjadi ".env.local" lalu isi nilainya.
#   cp .env.example .env.local
# Aplikasi tetap bisa di-build & dibuka walau nilai di bawah
# masih kosong (mode fallback tanpa Supabase).
# ============================================================

# URL project Supabase.
# Ambil di: Dashboard Supabase > pilih project > Project Settings > API > Project URL
# Contoh: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (anon) Supabase. Aman dipakai di browser karena dibatasi RLS.
# Ambil di: Dashboard Supabase > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PERINGATAN: kunci service role mem-bypass seluruh Row Level Security.
# HANYA boleh dipakai di sisi server (Server Action / Route Handler / service).
# JANGAN pernah diberi prefix NEXT_PUBLIC_ dan jangan pernah di-commit.
# Ambil di: Dashboard Supabase > Project Settings > API > Project API keys > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Alamat publik aplikasi ini, dipakai untuk membangun URL absolut
# (link status booking, redirect, dan callback auth admin).
# Lokal: http://localhost:3000 — Produksi: https://domain-anda.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
