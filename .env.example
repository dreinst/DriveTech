# ============================================================
# Drive Tech — contoh konfigurasi environment
# Salin file ini menjadi ".env.local" lalu isi nilainya.
#   cp .env.example .env.local
# Aplikasi tetap bisa di-build & dibuka walau nilai di bawah
# masih kosong (mode fallback tanpa database).
# ============================================================

# Koneksi Postgres (khusus server). Skema ada di db/skema.sql.
# Contoh: postgres://drivetech:sandi@localhost:5432/drivetech
DATABASE_URL=

# Rahasia tanda tangan cookie sesi admin dan URL bukti bayar (khusus server,
# minimal 16 karakter). Mengganti nilainya mengeluarkan semua admin yang
# sedang login. Buat dengan: openssl rand -hex 32
AUTH_SECRET=

# Folder penyimpanan berkas unggahan (foto kendaraan, bukti bayar). Bawaan
# ./data/unggahan; di produksi arahkan ke volume Docker supaya tidak hilang
# saat container diganti.
UPLOAD_DIR=

# Alamat publik aplikasi ini, dipakai untuk membangun URL absolut
# (link status booking dan alamat berkas unggahan).
# Lokal: http://localhost:3000 — Produksi: https://domain-anda.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Opsional) Sinkronisasi ke Google Sheets.
# Cara mendapatkan URL-nya:
#   1. Buka spreadsheet tujuan, menu Extensions > Apps Script.
#   2. Tempel isi tools/google-sheets-webhook.gs (langkah lengkap ada di
#      komentar atas file itu), lalu Deploy > New deployment > Web app
#      (Execute as: Me, Who has access: Anyone).
#   3. Salin "Web app URL" (berakhiran /exec) ke variabel di bawah.
# Kosongkan untuk menonaktifkan sinkronisasi (aplikasi tetap berjalan normal).
SHEETS_WEBHOOK_URL=
# Kunci aksi RECAP webhook Apps Script — samakan dengan RECAP_KEY di
# tools/google-sheets-webhook.gs. WAJIB diisi bila cron recap mingguan
# (/api/cron/weekly-recap) dipakai; tanpa ini recap tidak dipicu (503).
# Tidak ada lagi kunci bawaan di kode. Kunci reset (RESET_KEY) tidak pernah
# dipakai aplikasi dan hanya ada di editor Apps Script.
SHEETS_ACTION_KEY=

# ============================================================
# (Opsional) Notifikasi tenant — WhatsApp & Email
# Tanpa kredensial di bawah, notifikasi berjalan DRY-RUN (dicatat ke
# log server, tidak ada pesan sungguhan terkirim). Aplikasi tetap normal.
# ============================================================

# WhatsApp via Fonnte (https://fonnte.com). Isi token perangkat agar aktif.
WA_API_TOKEN=
# Endpoint kirim (default https://api.fonnte.com/send bila dikosongkan).
WA_API_URL=
# Mode uji: kalau diisi, SEMUA WA dialihkan ke nomor ini (mis. 6281200000000)
# supaya bisa mencoba tanpa mengganggu nomor tenant sungguhan.
WA_OVERRIDE_RECIPIENT=

# EMAIL = jalur UTAMA kode booking & notifikasi penyewa (keputusan 2026-09-03).
# Pilihan 1 — SMTP generik (Gmail: smtp.gmail.com 465 + App Password; Brevo;
# Zoho; dsb.). Bila SMTP_HOST+SMTP_USER+SMTP_PASS terisi, pengiriman email
# aktif DAN kode verifikasi email (OTP) diwajibkan sebelum booking dikunci.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Pengirim, mis. "Drive Tech <alamat@gmail.com>" (fallback NOTIF_EMAIL_FROM).
SMTP_FROM=
# Pilihan 2 — Resend (https://resend.com), dipakai bila SMTP_HOST kosong.
RESEND_API_KEY=
# Pengirim email untuk Resend (default "Drive Tech <no-reply@drivetech.local>").
NOTIF_EMAIL_FROM=
# (Opsional) garam tambahan untuk hash kode verifikasi email; kalau kosong
# memakai AUTH_SECRET. Nilai acak panjang.
OTP_PEPPER=

# Secret untuk endpoint cron (/api/cron/rutin, /api/cron/sync-cancelled,
# /api/cron/weekly-recap).
# WAJIB di produksi: tanpa nilai ini endpoint cron menolak semua permintaan
# (503), supaya tidak bisa dipicu orang luar. Timer di VPS mengirim
# "Authorization: Bearer <nilai>". Nilai acak panjang,
# mis. `openssl rand -hex 24`. Di development boleh dikosongkan.
CRON_SECRET=

# ============================================================
# (Opsional) Monitoring error via Sentry — server-side.
# Tanpa DSN, Sentry TIDAK aktif (aplikasi normal). Untuk mengaktifkan:
#   1. Daftar gratis di https://sentry.io (paket Developer), buat project Next.js.
#   2. Salin DSN project ke variabel di bawah, lalu redeploy.
# ============================================================
SENTRY_DSN=
# DSN yang sama versi PUBLIK (dipakai SDK browser untuk menangkap error di sisi
# pengunjung). Aman diekspos — DSN memang dirancang untuk itu. Kosongkan untuk
# mematikan penangkapan error browser (server tetap tertangkap lewat SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=
# (Opsional) untuk upload sourcemap saat build — biar stack trace terbaca.
# Butuh ketiganya; kosongkan kalau tidak perlu.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Penyedia WhatsApp untuk notifikasi penyewa: off (bawaan sejak 2026-09-03 —
# nomor kantor diblokir; kode booking lewat EMAIL), outbox (antre ke tabel
# notification_outbox lalu dikirim worker VPS lewat bot Hermes bila ada nomor
# bot), atau fonnte (butuh WA_API_TOKEN).
WA_PROVIDER=off
