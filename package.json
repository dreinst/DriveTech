{
  "name": "drive-tech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:muat": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/skema.sql -f db/seed.sql",
    "denah": "node --experimental-strip-types tools/generate-denah-svg.ts",
    "denah:check": "npm run -s denah && git diff --quiet -- public/denah.svg || echo \"public/denah.svg berubah — commit hasil regenerasi\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^10.72.0",
    "framer-motion": "^13.1.1",
    "next": "^15.5.24",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
